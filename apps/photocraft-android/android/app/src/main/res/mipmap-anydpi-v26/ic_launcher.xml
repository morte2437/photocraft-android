<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon as Android 8+ shapes it (circle, squircle, rounded square): the blue field
     behind the kitsune, drawn smaller than the desktop tile so the whole figure stays inside the
     launcher's mask. mipmap-xxxhdpi/ic_launcher_foreground.png is assets/app-icon/photocraft.svg
     without its blue tile, the 512-unit tile drawn at 250 of the 432 px (108 dp) layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
